# Kein WEAK_PULL_UP in diesem Projekt:
#  - reset_sw (89) und SW_Selftest (90) liegen auf dedizierten Takteingangs-Pins des
#    EP4CE6E22; die koennen keinen Pull-Up ("Error 169057"). Die Taster SW2/SW3 auf dem
#    dev_open-Board haben ihren eigenen externen Pull-Up.
#  - U1_SW/U2_SW werden von den Multiplexern U1/U2 aktiv getrieben (frueher GS_DIPS/OPT_DIPS
#    mit Pull-Up), brauchen also keinen.
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name VHDL_FILE ../lib_common/crc16_ccitt.vhd
set_global_assignment -name SDC_FILE Stern.sdc
# FA-Control: LISY-Gegenstelle zum ESP32-C3 in X7. Paket zuerst, danach die
# Module -- fa_io_bally braucht ausserdem DISPLAY_T aus boot_message.vhd.
set_global_assignment -name VHDL_FILE ../lib_common/boot_message.vhd
set_global_assignment -name VHDL_FILE ../lib_fa_control/fa_control_pkg.vhd
set_global_assignment -name VHDL_FILE ../lib_fa_control/uart_rx.vhd
