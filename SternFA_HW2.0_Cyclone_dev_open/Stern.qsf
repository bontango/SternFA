set_global_assignment -name VHDL_FILE ../lib_fa_control/fa_control.vhd
set_global_assignment -name VHDL_FILE ../lib_fa_control/fa_io_bally.vhd
set_global_assignment -name VHDL_FILE Stern.vhd
set_global_assignment -name VHDL_FILE ../lib_common/pia6821.vhd
